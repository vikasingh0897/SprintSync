# ==========================================
# SprintSync Production MERN Backend Config
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and email confirmation links)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas URI or local mongod)
# e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/sprintsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sprintsync

# JWT Secret for Session Authentication
JWT_SECRET=sprintsync_super_secret_jwt_key_2026_production_ready
JWT_EXPIRE=7d

# Google Apps Script Email Bridge (Recommended for Render Free Tier - 100% Free, No Domain Needed, Sends to ALL users via Gmail)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=sprintsync_apps_script_secret_2026

# Resend Transactional Email API (Alternative HTTPS API - requires verified domain to send to team members)
RESEND_API_KEY=
# Verified domain sender (defaults to onboarding@resend.dev for owner-only testing until domain is verified in Resend)
RESEND_FROM_EMAIL=

# Brevo Transactional Email API (Alternative HTTPS API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ADMIN_EMAIL=

# Optional Brevo SMTP / Generic SMTP Fallback (If BREVO_API_KEY & SMTP_USER are omitted, uses Ethereal test account)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@sprintsync.io
FROM_NAME="SprintSync Team"
